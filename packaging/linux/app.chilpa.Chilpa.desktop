[Desktop Entry]
Type=Application
Name=Chilpa
Comment=Music player
Exec=/usr/bin/chilpa-qt %U
Icon=app.chilpa.Chilpa
Terminal=false
Categories=AudioVideo;Audio;Music;Player;Qt;
Keywords=music;audio;player;hifi;flac;lyrics;
StartupNotify=true
# "Open with" in a file manager: files and folders open as temporary media.
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp4;audio/x-m4a;audio/aac;audio/ogg;audio/x-vorbis+ogg;audio/x-wav;audio/x-aiff;inode/directory;
StartupWMClass=chilpa-qt
# KWin hands org_kde_plasma_window_management only to a binary a desktop
# entry names with this line; the wallpaper background reads the window's
# place on the screen through it. Without it the crop stays centred.
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
