#!/usr/bin/env python3
"""Cuts Inter down to the scripts the window writes, keeping every weight.

The window's typography needs real weights (400 to 700 and the 650 of the
headings). Plenty of desktops set a UI font that has one face -- a patched
font with only Regular is common -- and Qt does not embolden it, so every
title came out regular. Inter ships in the binary as the default for that
reason; Settings can go back to the system's font.

The variable font keeps its weight axis, so one file draws every weight.
Latin (with its extensions), Greek, Cyrillic and the punctuation the
window uses are kept; anything else falls back to the system's fonts.

Usage: tools/fonts/subset-inter <path to InterVariable.ttf from rsms/inter>
Needs fontTools (`pip install fonttools`).
"""
import subprocess
import sys
from pathlib import Path

try:
    from fontTools import subset
except ImportError:
    sys.exit("subset-inter: needs fontTools (pip install fonttools)")

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
OUT = ROOT / "crates/chilpa-qt/assets/fonts/Inter.ttf"
RANGES = [
    (0x0000, 0x024F),  # Latin, Latin-1, Latin Extended-A and -B
    (0x0300, 0x036F),  # combining marks
    (0x0370, 0x03FF),  # Greek
    (0x0400, 0x04FF),  # Cyrillic
    (0x1E00, 0x1EFF),  # Latin Extended Additional
    (0x2000, 0x206F),  # general punctuation: dashes, quotes, ellipsis
    (0x20AC, 0x20AC),  # euro
    (0x2190, 0x2193),  # arrows
    (0x2212, 0x2212),  # minus
    (0x2318, 0x2318),  # the command key
]


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    options = subset.Options()
    options.layout_features = ["*"]
    options.name_IDs = ["*"]
    options.notdef_outline = True
    font = subset.load_font(sys.argv[1], options)
    cutter = subset.Subsetter(options)
    cutter.populate(unicodes=[c for lo, hi in RANGES for c in range(lo, hi + 1)])
    cutter.subset(font)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    subset.save_font(font, str(OUT), options)
    print(f"subset-inter: {OUT.stat().st_size // 1024} KB")


if __name__ == "__main__":
    main()
