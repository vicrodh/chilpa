#!/usr/bin/env python3
"""What keeps a Mac's window controls where they are, written down.

On a Mac the window keeps the system's three controls and they sit at the
height of the tab bar's buttons. Getting there took its turns, and each of
these was one of them:

- a frameless window has no controls at all, so the window is framed there
  and asks Qt for the client area under the title bar;
- the style mask set behind Qt's back is assigned over on the next change
  of state, so nothing here touches it;
- the first asking comes before there is a window, so it is asked again
  until it is done, and again when the window changes state, which is when
  the system parks them back;
- a drawn set beside the system's is two sets, so the bar draws none there
  and leaves them their room;
- a title hidden from AppKit alone still showed beside them, so the window
  has none there.

None of it can be seen from a machine that is not a Mac. This does not see
it either: it keeps the pieces from being taken away unnoticed.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
QML = ROOT / "crates/chilpa-qt/qml"

NEEDED = [
    ("Main.qml", r"systemControls\.kept\s*\?\s*Qt\.Window\s*\|\s*Qt\.ExpandedClientAreaHint\s*\|\s*Qt\.NoTitleBarBackgroundHint",
     "the window is framed on a Mac, its client area under the title bar"),
    ("Main.qml", r"controlsRoom:\s*systemControls\.room", "the tab bar is told the room the controls take"),
    ("Main.qml", r"title:\s*systemControls\.kept\s*\?\s*\"\"", "the window has no title beside the controls on a Mac"),
    ("Patterns/SystemControls.qml", r"Metrics\.tabBarTop \+ Metrics\.button28 / 2", "their middle is the middle of the bar's buttons"),
    ("Patterns/SystemControls.qml", r"repeat:\s*true", "their placing is asked until it is done"),
    ("Patterns/SystemControls.qml", r"function onVisibilityChanged", "their placing is asked again when the window changes state"),
    ("Patterns/SystemControls.qml", r"SafeArea\.margins\.left", "the room they take is what the system says"),
    ("Patterns/TabBar.qml", r"width:\s*bar\.controlsRoom", "the bar leaves them their room"),
    ("Patterns/TabBar.qml", r"model:\s*bar\.mac\s*\?\s*\[\]", "the bar draws no controls of its own on a Mac"),
]
FORBIDDEN = [
    ("crates/chilpa-appkit/src/lights.rs", r"[sS]tyleMask", "the style mask is Qt's: it assigns it over on every change of state"),
]


def main():
    errors = []
    for name, pattern, what in NEEDED:
        path = QML / name
        if not path.exists() or not re.search(pattern, path.read_text()):
            errors.append(f"crates/chilpa-qt/qml/{name}: {what}, and that is gone")
    for name, pattern, what in FORBIDDEN:
        path = ROOT / name
        if not path.exists():
            errors.append(f"{name}: the file is gone")
        elif re.search(pattern, path.read_text()):
            errors.append(f"{name}: {what}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        print(f"mac-window: {len(errors)} error(s)", file=sys.stderr)
        sys.exit(1)
    print(f"mac-window: the {len(NEEDED) + len(FORBIDDEN)} pieces that keep a Mac's window controls in place are there")


if __name__ == "__main__":
    main()
