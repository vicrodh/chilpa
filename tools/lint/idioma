#!/usr/bin/env python3
"""El repo de código va en inglés: identificadores, comentarios y cadenas.

Lo único que se queda en español es lo que lee el usuario final, y eso sale
de los archivos de traducción, no de aquí (ADR-001).

Este candado mira las tres cosas. Un identificador con una palabra española
adentro, un comentario escrito en español, y una cadena en español que no
esté marcada para traducir.

Una palabra se considera española si el inglés la rechaza y el es_MX la
acepta, o la aceptaría con acentos. Lo segundo hace falta porque un
identificador no lleva acentos: `titulos` y `razon` no están en ningún
diccionario, pero `títulos` y `razón` sí, y el corrector las sugiere.

Sin hunspell instalado se usa `palabras-es.txt`, que trae las que ya
aparecieron en este repo: alcanza para lo de siempre, pero no ve palabras
nuevas, y por eso el mensaje lo dice.

Lo que no es español y el diccionario marca igual (abreviaturas, jerga de
audio, nombres de la API de Rust) vive en `permitidas-idioma.txt`.

Le queda un punto ciego y conviene saberlo: una palabra que los dos
diccionarios aceptan no se puede distinguir. `cola`, `hasta` y `linux` pasan
sin que nadie las vea. Este candado atrapa la deriva, no la sustituye por
leer el diff.
"""
import re
import subprocess
import sys
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
BASE = Path(__file__).resolve().parent


def sin_acentos(s):
    return "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")


def trozos_rust(src):
    """(tipo, texto) con tipo en code|comment|string. Reconoce r#"..."# y 'a."""
    out, i, n, ini = [], 0, len(src), 0
    while i < n:
        c = src[i]
        if c == "/" and src[i : i + 2] == "//":
            out.append(("code", src[ini:i]))
            j = src.find("\n", i)
            j = n if j < 0 else j
            out.append(("comment", src[i:j]))
            i = ini = j
        elif c == "/" and src[i : i + 2] == "/*":
            out.append(("code", src[ini:i]))
            depth, j = 1, i + 2
            while j < n and depth:
                if src[j : j + 2] == "/*":
                    depth, j = depth + 1, j + 2
                elif src[j : j + 2] == "*/":
                    depth, j = depth - 1, j + 2
                else:
                    j += 1
            out.append(("comment", src[i:j]))
            i = ini = j
        elif c in "rb" and (m := re.match(r'(?:b?r|rb)(#*)"', src[i:])):
            out.append(("code", src[ini:i]))
            cierra = '"' + m.group(1)
            j = src.find(cierra, i + m.end())
            j = n if j < 0 else j + len(cierra)
            out.append(("string", src[i:j]))
            i = ini = j
        elif c == '"':
            out.append(("code", src[ini:i]))
            j = i + 1
            while j < n and src[j] != '"':
                j += 2 if src[j] == "\\" else 1
            j = min(j + 1, n)
            out.append(("string", src[i:j]))
            i = ini = j
        elif c == "'":
            # Un lifetime no es un char.
            m = re.match(r"'(?:\\.|[^\\'])'", src[i:])
            if m:
                out.append(("code", src[ini:i]))
                out.append(("string", m.group(0)))
                i = ini = i + m.end()
            else:
                i += 1
        else:
            i += 1
    out.append(("code", src[ini:]))
    return [t for t in out if t[1]]


def trozos_qml(src):
    out, i, n, ini = [], 0, len(src), 0
    while i < n:
        c = src[i]
        if c == "/" and src[i : i + 2] == "//":
            out.append(("code", src[ini:i]))
            j = src.find("\n", i)
            j = n if j < 0 else j
            out.append(("comment", src[i:j]))
            i = ini = j
        elif c == "/" and src[i : i + 2] == "/*":
            out.append(("code", src[ini:i]))
            j = src.find("*/", i + 2)
            j = n if j < 0 else j + 2
            out.append(("comment", src[i:j]))
            i = ini = j
        elif c in "\"'`":
            out.append(("code", src[ini:i]))
            q, j = c, i + 1
            while j < n and src[j] != q:
                j += 2 if src[j] == "\\" else 1
            j = min(j + 1, n)
            out.append(("string", src[i:j]))
            i = ini = j
        else:
            i += 1
    out.append(("code", src[ini:]))
    return [t for t in out if t[1]]


def palabras(ident):
    partes = []
    for t in ident.split("_"):
        partes += re.findall(r"[A-Z]+(?![a-z])|[A-Z][a-z]+|[a-z]+", t)
    # Dos letras alcanzan para "de" y "la", que es como se colaba
    # `host_de_url` con sus dos mitades en inglés.
    return [p.lower() for p in partes if len(p) > 1]


def hunspell(dic, tokens):
    """Los que ESE diccionario rechaza. None si no se puede preguntar."""
    try:
        r = subprocess.run(
            ["hunspell", "-d", dic, "-l"],
            input="\n".join(tokens),
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return set(r.stdout.split())


def solo_les_falta_el_acento(tokens):
    """Los que serían españoles con acentos: `titulos` -> `títulos`.

    Se le pide al corrector qué quiso decir; si alguna sugerencia es la
    misma palabra con acentos, era español escrito como se escribe un
    identificador.
    """
    if not tokens:
        return set()
    try:
        r = subprocess.run(
            ["hunspell", "-d", "es_MX", "-a"],
            input="\n".join(tokens),
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return set()
    out = set()
    for linea in r.stdout.splitlines():
        # "& palabra N offset: sug1, sug2, ..."
        if not linea.startswith("& "):
            continue
        cabeza, _, cola = linea.partition(":")
        palabra = cabeza.split()[1]
        if any(sin_acentos(s.strip().lower()) == palabra for s in cola.split(",")):
            out.add(palabra)
    return out


def palabras_de(texto):
    """Las palabras de un texto, sin lo que va entre acentos graves ni URLs.

    Lo que va en `backticks` es un identificador y ya lo revisa la otra
    mitad de este candado; contarlo aquí marcaría comentarios en inglés que
    nombran una función.
    """
    texto = re.sub(r"`[^`]*`", " ", texto)
    texto = re.sub(r"https?://\S+", " ", texto)
    texto = re.sub(r"\[[^\]]*\]\([^)]*\)", " ", texto)
    return [w.lower() for w in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{3,}", texto)]


def sin_acentos_lista(palabras):
    return [sin_acentos(w) for w in palabras]


def lista(nombre):
    f = BASE / nombre
    if not f.exists():
        return set()
    return {
        l.strip().lower()
        for l in f.read_text().splitlines()
        if l.strip() and not l.startswith("#")
    }


def es_espanol(palabra, no_es, no_en, acentos):
    """Cierto si esa palabra es española y no inglesa."""
    if palabra not in no_en:
        return False
    return palabra not in no_es or palabra in acentos


def main():
    permitidas = lista("permitidas-idioma.txt")
    archivos = sorted(ROOT.glob("crates/*/**/*.rs")) + sorted(ROOT.glob("crates/*/qml/*.qml"))

    # Identificador -> dónde salió la primera vez, y los comentarios con su
    # lugar, que es lo que hay que poder señalar.
    donde = {}
    comentarios = []
    for f in archivos:
        src = f.read_text()
        piezas = trozos_qml(src) if f.suffix == ".qml" else trozos_rust(src)
        linea = 1
        for tipo, texto in piezas:
            if tipo == "code":
                for m in re.finditer(r"\b[A-Za-z_][A-Za-z0-9_]*\b", texto):
                    donde.setdefault(
                        m.group(0),
                        (f.relative_to(ROOT), linea + texto[: m.start()].count("\n")),
                    )
            elif tipo == "comment":
                comentarios.append((f.relative_to(ROOT), linea, texto))
            linea += texto.count("\n")

    de_ids = {p for i in donde for p in palabras(i)}
    de_prosa = {w for _, _, t in comentarios for w in palabras_de(t)}
    tokens = sorted((de_ids | de_prosa) - permitidas)

    no_es = hunspell("es_MX", tokens)
    no_en = hunspell("en_US", tokens)
    aviso = None
    if no_es is None or no_en is None:
        base = {sin_acentos(w) for w in lista("palabras-es.txt")}
        no_es = {t for t in tokens if t not in base}
        no_en = set(tokens)
        acentos = set()
        aviso = "idioma: sin hunspell; solo se revisó la lista base"
    else:
        # Solo se le pregunta por los que ningún diccionario reconoce:
        # pedir sugerencias es lo caro de esto.
        acentos = solo_les_falta_el_acento(sorted(no_es & no_en))

    espanol = {t for t in tokens if es_espanol(t, no_es, no_en, acentos)}

    errores = []

    malos = sorted((donde[i], i) for i in donde if any(p in espanol for p in palabras(i)))
    if malos:
        errores.append("el código va en inglés; estos identificadores no lo están:")
        errores += [f"  {f}:{n}: {i}" for (f, n), i in malos]

    # Un comentario se marca con dos palabras españolas, no con una: en uno
    # escrito en inglés puede aparecer una prestada, y marcarlo por eso
    # volvería el candado ruido que nadie lee.
    prosa = []
    for f, n, texto in comentarios:
        hay = sorted({w for w in palabras_de(texto) if w in espanol})
        if len(hay) >= 2:
            prosa.append((f, n, hay[:4]))
    # El trinquete se quitó el 2026-09-23, cuando la cuenta llegó a cero.
    # Ahora no hay tope: ni un comentario en español.
    if prosa:
        errores.append(f"los comentarios también van en inglés; hay {len(prosa)} en español:")
        errores += [f"  {f}:{n}: {', '.join(w)}…" for f, n, w in prosa[:15]]
        if len(prosa) > 15:
            errores.append(f"  … y {len(prosa) - 15} más")

    if errores:
        print("\n".join(errores))
        print()
        print("Si alguno no es español, agrégalo a tools/lint/permitidas-idioma.txt.")
        return 1

    print(
        f"idioma: {len(donde)} identificadores y {len(comentarios)} comentarios, "
        f"todos en inglés"
    )
    if aviso:
        print(aviso)
    return 0


if __name__ == "__main__":
    sys.exit(main())
