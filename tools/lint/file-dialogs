#!/usr/bin/env python3
"""One way to ask for a file or a folder: the system's own dialog.

The desktop portal on Linux and the native panels on macOS and Windows are
what the person knows from every other program. Qt's QML dialogs
(`FileDialog`, `FolderDialog`) are not: without a platform theme they draw
a dialog of their own. And a bridge that opens `rfd` by itself repeats the
same thread, wait and hand-back as every other one. So a file or a folder is
asked through the kit: `chilpa_qt_kit::dialogs::ask` from a bridge, the
`SystemDialogs` singleton from QML (frontend ADR-0022, draft).

The files that asked some other way when this lock was written are in
`file-dialogs-allowed.txt`. That list only shrinks: a file that is not in it
fails here, and so does an entry that no longer asks another way.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
ALLOWED = Path(__file__).resolve().parent / "file-dialogs-allowed.txt"
HOME = {"crates/chilpa-qt-kit/src/dialogs.rs", "crates/chilpa-qt-kit/Cargo.toml"}
QML = re.compile(r"(^|[^A-Za-z])(FileDialog|FolderDialog)\s*\{|import\s+QtQuick\.Dialogs")
RUST = re.compile(r"\brfd::")
CARGO = re.compile(r"^rfd\s*=", re.MULTILINE)


def tracked():
    names = subprocess.run(["git", "ls-files", "crates"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
    return [name for name in names if name.endswith((".qml", ".rs", "Cargo.toml"))]


def asks_another_way(name, text):
    if name.endswith(".qml"):
        return bool(QML.search(text))
    if name.endswith(".rs"):
        return bool(RUST.search(text))
    return bool(CARGO.search(text))


def main():
    found = set()
    for name in tracked():
        path = ROOT / name
        if name in HOME or not path.is_file():
            continue
        if asks_another_way(name, path.read_text(errors="replace")):
            found.add(name)
    allowed = {line.strip() for line in ALLOWED.read_text().splitlines() if line.strip() and not line.startswith("#")}
    errors = [f"{name}: asks for a file or a folder some other way. Use chilpa_qt_kit::dialogs from a bridge, SystemDialogs from QML (frontend ADR-0022)." for name in sorted(found - allowed)]
    errors += [f"{ALLOWED.relative_to(ROOT)}: `{name}` no longer asks another way; take it off the list." for name in sorted(allowed - found)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        print(f"file-dialogs: {len(errors)} error(s)", file=sys.stderr)
        sys.exit(1)
    print(f"file-dialogs: every new file or folder is asked through the kit; {len(allowed)} older ones still to move")


if __name__ == "__main__":
    main()
