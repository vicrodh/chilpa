#!/usr/bin/env python3
"""Keep popup input, transitions and dismissal inside the active layer."""
import re
import sys
from pathlib import Path

sys.path.insert(0, __file__.rsplit("/", 1)[0])
from qmllib import KIT, code_only, files, rel, resolve_import, without_comments  # noqa: E402


def surfaces(code):
    for match in re.finditer(r"\b(?:\w+\.)?(Popup|Modal)\s*\{", code):
        start = match.end()
        depth = 1
        end = start
        while end < len(code) and depth:
            depth += (code[end] == "{") - (code[end] == "}")
            end += 1
        yield match.group(1), code[start:end - 1], code.count("\n", 0, match.start()) + 1


def violations(source):
    errors = []
    for kind, body, line in surfaces(code_only(source)):
        modal = kind == "Modal" or re.search(r"\bmodal\s*:\s*true\b", body)
        if modal and re.search(r"\bCloseOnPressOutside(?:Parent)?\b", body):
            errors.append((line, "a modal must not close on press; use release or an explicit close action"))
        if kind == "Popup":
            identity = re.search(r"\bid\s*:\s*(\w+)", body)
            guard = re.search(r"\bPopupInput\s*\{\s*surface\s*:\s*(\w+)\s*\}", body)
            if not identity or not guard or identity.group(1) != guard.group(1):
                errors.append((line, "a Popup needs PopupInput bound to its own id, including custom content"))
            if modal and not re.search(r"\bclosePolicy\s*:", body):
                errors.append((line, "a modal Popup needs an explicit close policy"))
    return errors


def import_violations(source, path):
    available = {""} if path.parent.resolve() == (KIT / "Primitives").resolve() else set()
    for target, alias in re.findall(r'^\s*import\s+"([^"]+)"(?:\s+as\s+(\w+))?', without_comments(source), re.MULTILINE):
        if resolve_import(path, target) == (KIT, Path("Primitives")):
            available.add(alias)
    code = code_only(source)
    return [(code.count("\n", 0, match.start()) + 1, "PopupInput needs the kit Primitives import in its own namespace")
            for match in re.finditer(r"(?<![\w.])(?:(\w+)\.)?PopupInput\s*\{", code)
            if (match.group(1) or "") not in available]


def main():
    errors = [f"{rel(path)}:{line}: {message}" for path in files()
              for line, message in violations(path.read_text()) + import_violations(path.read_text(), path)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)
    print("qml-modal-input: popups contain pointer input and modal dismissal stays on release")


if __name__ == "__main__":
    main()
