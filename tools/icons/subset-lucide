#!/usr/bin/env python3
"""Build Chilpa's tiny Lucide font from an unpacked lucide-static package.

Usage: tools/icons/subset-lucide <path to lucide-static>
Needs fontforge with its Python module.
"""
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
LIST = Path(__file__).resolve().parent / "lucide.txt"
OUT = ROOT / "crates/chilpa-qt-kit/assets/icons/lucide.ttf"
QML = ROOT / "crates/chilpa-qt-kit/qml/Theme/Lucide.qml"


def camel(name: str) -> str:
    head, *rest = name.split("-")
    return head + "".join(part[:1].upper() + part[1:] for part in rest)


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    package = Path(sys.argv[1])
    font_dir = package / "font"
    points = json.loads((font_dir / "codepoints.json").read_text())
    wanted = [line.strip() for line in LIST.read_text().splitlines() if line.strip() and not line.startswith("#")]
    missing = [name for name in wanted if name not in points]
    if missing:
        sys.exit(f"subset-lucide: missing {', '.join(missing)}")
    # Glyph by glyph, not by encoding slot: a glyph named like a letter ("x")
    # sits in two slots, its private code point and the letter's, and
    # clearing the slots left over after selecting the wanted ones cleared
    # it too. Each wanted glyph keeps its private code point alone.
    script = """
import fontforge, sys
font = fontforge.open(sys.argv[1])
wanted = [int(cp) for cp in sys.argv[3].split(",")]
keep = set()
for cp in wanted:
    glyph = next(g for g in font.glyphs() if g.unicode == cp or (g.altuni and any(a[0] == cp for a in g.altuni)))
    glyph.unicode = cp
    glyph.altuni = None
    keep.add(glyph.glyphname)
for glyph in list(font.glyphs()):
    if glyph.glyphname not in keep and glyph.glyphname != ".notdef":
        font.removeGlyph(glyph)
font.fontname, font.familyname, font.fullname = "ChilpaLucide", "Chilpa Lucide", "Chilpa Lucide"
font.generate(sys.argv[2])
"""
    OUT.parent.mkdir(parents=True, exist_ok=True)
    codes = ",".join(str(points[name]) for name in wanted)
    subprocess.run(["fontforge", "-lang=py", "-c", script, str(font_dir / "lucide.ttf"), str(OUT), codes], check=True)
    version = json.loads((package / "package.json").read_text())["version"]
    properties = "\n".join(f'    readonly property string {camel(name)}: "\\u{points[name]:04x}"' for name in sorted(wanted))
    QML.write_text(
        "pragma Singleton\nimport QtQuick\n\n"
        f"// Generated from Lucide {version} (ISC, licenses/lucide-icons.txt).\n"
        "QtObject {\n"
        "    readonly property FontLoader iconFont: FontLoader { source: \"../../assets/icons/lucide.ttf\" }\n"
        "    readonly property string font: iconFont.name\n\n"
        f"{properties}\n}}\n"
    )
    shutil.copyfile(package / "LICENSE", ROOT / "licenses/lucide-icons.txt")
    print(f"subset-lucide: {len(wanted)} glyphs")


if __name__ == "__main__":
    main()
