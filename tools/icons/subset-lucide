#!/usr/bin/env python3
"""Build Chilpa's tiny Lucide font from an unpacked lucide-static package.

Usage: tools/icons/subset-lucide <path to lucide-static>
Needs fontforge.
"""
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
LIST = Path(__file__).resolve().parent / "lucide.txt"
OUT = ROOT / "crates/chilpa-qt/assets/icons/lucide.ttf"
QML = ROOT / "crates/chilpa-qt/qml/Theme/Lucide.qml"


def camel(name: str) -> str:
    head, *rest = name.split("-")
    return head + "".join(part[:1].upper() + part[1:] for part in rest)


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    package = Path(sys.argv[1])
    font_dir = package / "font"
    points = json.loads((font_dir / "codepoints.json").read_text())
    wanted = [line.strip() for line in LIST.read_text().splitlines() if line.strip() and not line.startswith("#")]
    missing = [name for name in wanted if name not in points]
    if missing:
        sys.exit(f"subset-lucide: missing {', '.join(missing)}")
    commands = ["Open($1)", "SelectNone()", f"Select(0u{points[wanted[0]]:X})"]
    commands += [f"SelectMore(0u{points[name]:X})" for name in wanted[1:]]
    commands += ["SelectInvert()", "Clear()", 'SetFontNames("ChilpaLucide","Chilpa Lucide","Chilpa Lucide")', "Generate($2)"]
    OUT.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["fontforge", "-lang=ff", "-c", "; ".join(commands), str(font_dir / "lucide.ttf"), str(OUT)], check=True)
    version = json.loads((package / "package.json").read_text())["version"]
    properties = "\n".join(f'    readonly property string {camel(name)}: "\\u{points[name]:04x}"' for name in sorted(wanted))
    QML.write_text(
        "pragma Singleton\nimport QtQuick\n\n"
        f"// Generated from Lucide {version} (ISC, licenses/lucide-icons.txt).\n"
        "QtObject {\n"
        "    readonly property FontLoader iconFont: FontLoader { source: \"../../assets/icons/lucide.ttf\" }\n"
        "    readonly property string font: iconFont.name\n\n"
        f"{properties}\n}}\n"
    )
    shutil.copyfile(package / "LICENSE", ROOT / "licenses/lucide-icons.txt")
    print(f"subset-lucide: {len(wanted)} glyphs")


if __name__ == "__main__":
    main()
