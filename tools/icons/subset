#!/usr/bin/env python3
"""Cuts the Tabler webfonts down to the glyphs in icons.txt.

The window draws its icons as glyphs of a font: a glyph is text, so it is
colored like text and costs what a letter costs. No SVG is decoded per icon
and no effect recolors one. The full fonts carry 5,000 icons (1.8 MB); the
window uses a few dozen, and this keeps only those.

Writes the two subset fonts to crates/chilpa-qt-kit/assets/icons/ and the glyph
map to crates/chilpa-qt-kit/qml/Theme/Icons.qml, where each icon is a typed
property: `Icons.playerPlayFilled`.

Usage: tools/icons/subset <path to an unpacked @tabler/icons-webfont>
Needs fontTools (`pip install fonttools`).
"""
import re
import subprocess
import sys
from pathlib import Path

try:
    from fontTools import subset
except ImportError:
    sys.exit("subset: needs fontTools (pip install fonttools)")

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
LIST = Path(__file__).resolve().parent / "icons.txt"
OUT = ROOT / "crates/chilpa-qt-kit/assets/icons"
QML = ROOT / "crates/chilpa-qt-kit/qml/Theme/Icons.qml"
FONTS = {"outline": "tabler-icons", "filled": "tabler-icons-filled"}


def codepoints(css: Path):
    text = css.read_text()
    return {m[1]: int(m[2], 16) for m in re.finditer(r'\.ti-([a-z0-9-]+):before\s*\{\s*content:\s*"\\([0-9a-f]+)"', text)}


def camel(name: str) -> str:
    head, *rest = name.split("-")
    return head + "".join(p[:1].upper() + p[1:] for p in rest)


def qml_escape(point: int) -> str:
    if point <= 0xFFFF:
        return f"\\u{point:04x}"
    point -= 0x10000
    return f"\\u{0xD800 + (point >> 10):04x}\\u{0xDC00 + (point & 0x3FF):04x}"


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    package = Path(sys.argv[1])
    dist = package / "dist" if (package / "dist").is_dir() else package
    version = re.search(r'"version":\s*"([^"]+)"', (dist.parent / "package.json").read_text())[1]
    wanted = {"outline": [], "filled": []}
    for line in LIST.read_text().split("\n"):
        line = line.strip()
        if line and not line.startswith("#"):
            kind, _, name = line.rpartition(":")
            wanted[kind or "outline"].append(name)
    OUT.mkdir(parents=True, exist_ok=True)
    props = []
    for kind, stem in FONTS.items():
        points = codepoints(dist / f"{stem}.css")
        missing = [n for n in wanted[kind] if n not in points]
        if missing:
            sys.exit(f"subset: not in the {kind} font: {', '.join(missing)}")
        options = subset.Options()
        options.layout_features = []
        options.name_IDs = ["*"]
        font = subset.load_font(str(dist / "fonts" / f"{stem}.ttf"), options)
        cutter = subset.Subsetter(options)
        cutter.populate(unicodes=[points[n] for n in wanted[kind]])
        cutter.subset(font)
        # Both webfonts are called "tabler-icons", and two files with one
        # family name are merged by the font database: outline glyphs came
        # out of the filled font. Each subset gets a family of its own.
        family = f"Chilpa Icons {kind.capitalize()}"
        for record in font["name"].names:
            if record.nameID in (1, 4, 6, 16):
                record.string = family.replace(" ", "") if record.nameID == 6 else family
        subset.save_font(font, str(OUT / f"tabler-{kind}.ttf"), options)
        suffix = "Filled" if kind == "filled" else ""
        for n in sorted(wanted[kind]):
            props.append(f'    readonly property string {camel(n)}{suffix}: "{qml_escape(points[n])}"')
    QML.write_text(
        "pragma Singleton\n"
        "import QtQuick\n\n"
        f"// Generated by tools/icons/subset from Tabler Icons {version} (MIT,\n"
        "// licenses/tabler-icons.txt). Edit tools/icons/icons.txt and run it again.\n"
        "QtObject {\n"
        "    readonly property FontLoader outlineFont: FontLoader { source: \"../../assets/icons/tabler-outline.ttf\" }\n"
        "    readonly property FontLoader filledFont: FontLoader { source: \"../../assets/icons/tabler-filled.ttf\" }\n"
        "    readonly property string outline: outlineFont.name\n"
        "    readonly property string filled: filledFont.name\n\n"
        + "\n".join(props)
        + "\n}\n"
    )
    print(f"subset: {len(wanted['outline'])} outline and {len(wanted['filled'])} filled glyphs")


if __name__ == "__main__":
    main()
