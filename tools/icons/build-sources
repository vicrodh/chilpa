#!/usr/bin/env python3
"""Build the font of source icons from the drawings in tools/icons/sources.

Usage: tools/icons/build-sources
Needs fontforge and inkscape.

A source's icon is a glyph, like every other icon: it takes the color of the
text around it, so a theme, a hover or a color that moves tints it and nothing
is drawn twice. Each drawing is one color and any size; it is fitted to the
em square here. A drawing made of strokes is turned into outlines first,
because a glyph has no strokes.
"""
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
HERE = Path(__file__).resolve().parent
LIST = HERE / "sources.txt"
DRAWINGS = HERE / "sources"
OUT = ROOT / "crates/chilpa-qt/assets/icons/sources.ttf"
QML = ROOT / "crates/chilpa-qt/qml/Theme/SourceGlyphs.qml"
FIRST = 0xE000
EM = 1000
# The drawing fills this much of the em square, centered: Tabler's glyphs
# leave about the same air, so both sit alike in a row.
FILL = 0.84

FORGE = r"""
import sys, fontforge, psMat
out, em, fill, first = sys.argv[1], int(sys.argv[2]), float(sys.argv[3]), int(sys.argv[4])
font = fontforge.font()
font.encoding = "UnicodeFull"
font.em = em
font.ascent = em
font.descent = 0
font.fontname = "ChilpaSources"
font.familyname = "Chilpa Sources"
font.fullname = "Chilpa Sources"
for place, item in enumerate(sys.argv[5:]):
    name, path = item.split("=", 1)
    glyph = font.createChar(first + place, name)
    glyph.importOutlines(path)
    glyph.removeOverlap()
    glyph.correctDirection()
    left, bottom, right, top = glyph.boundingBox()
    wide, tall = right - left, top - bottom
    if wide <= 0 or tall <= 0:
        sys.exit("build-sources: %s has no outline" % name)
    scale = em * fill / max(wide, tall)
    glyph.transform(psMat.translate(-left - wide / 2, -bottom - tall / 2))
    glyph.transform(psMat.scale(scale))
    glyph.transform(psMat.translate(em / 2, em / 2))
    glyph.width = em
    glyph.round()
font.generate(out)
"""


def camel(name: str) -> str:
    head, *rest = name.split("-")
    return head + "".join(part[:1].upper() + part[1:] for part in rest)


def outlined(drawing: Path, into: Path) -> Path:
    """The drawing with every stroke turned into an outline."""
    if "stroke-width" not in drawing.read_text():
        return drawing
    out = into / drawing.name
    actions = "select-all:all;object-stroke-to-path;export-plain-svg;export-filename:%s;export-do" % out
    subprocess.run(["inkscape", "--batch-process", "--actions=" + actions, str(drawing)], check=True, capture_output=True)
    return out


def main() -> None:
    if len(sys.argv) != 1:
        sys.exit(__doc__)
    wanted = [line.strip() for line in LIST.read_text().splitlines() if line.strip() and not line.startswith("#")]
    missing = [name for name in wanted if not (DRAWINGS / f"{name}.svg").exists()]
    if missing:
        sys.exit(f"build-sources: missing {', '.join(missing)}")
    OUT.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as scratch:
        items = [f"{name}={outlined(DRAWINGS / f'{name}.svg', Path(scratch))}" for name in wanted]
        script = Path(scratch) / "forge.py"
        script.write_text(FORGE)
        subprocess.run(["fontforge", "-lang=py", "-script", str(script), str(OUT), str(EM), str(FILL), str(FIRST), *items], check=True)
    properties = "\n".join(f'    readonly property string {camel(name)}: "\\u{FIRST + place:04x}"' for place, name in enumerate(wanted))
    QML.write_text(
        "pragma Singleton\nimport QtQuick\n\n"
        "// Generated by tools/icons/build-sources from tools/icons/sources\n"
        "// (licenses/source-icons.txt). Edit tools/icons/sources.txt and run it again.\n"
        "QtObject {\n"
        "    readonly property FontLoader iconFont: FontLoader { source: \"../../assets/icons/sources.ttf\" }\n"
        "    readonly property string font: iconFont.name\n\n"
        "    // The glyph a source names in `sources.icon`, or none.\n"
        "    function of(name) {\n"
        "        const key = (name || \"\").replace(/-(\\w)/g, (m, c) => c.toUpperCase())\n"
        "        return typeof this[key] === \"string\" && key !== \"font\" ? this[key] : \"\"\n"
        "    }\n\n"
        f"{properties}\n}}\n"
    )
    print(f"build-sources: {len(wanted)} glyphs")


if __name__ == "__main__":
    main()
