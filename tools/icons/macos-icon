#!/usr/bin/env python3
"""Build the 1024 masters the macOS .icns is made from.

The artwork in `crates/chilpa-qt-kit/assets/app-icon-*.png` fills its whole
canvas. An .icns that does the same draws taller than every other icon in the
Dock, so each master here puts the artwork in a squircle body with a margin
around it and a soft shadow under it. The body is 896 of 1024 points with a
superelipse of exponent 4.4: what the latest QBZ's icon measures (body 64 to
960, 62 px of margin; its corners are as round as that exponent).

Usage: tools/icons/macos-icon
Needs Pillow. Writes crates/chilpa-qt-kit/assets/app-icon-macos-light.png and app-icon-macos-dark.png.
"""
import subprocess
from pathlib import Path
from PIL import Image, ImageChops, ImageDraw, ImageFilter

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
CANVAS = 1024
BODY = 896
EXPONENT = 4.4
TRIM = 12  # points of the art cut off all round, its own keyline
SUPER = 4  # the mask is drawn this many times larger and reduced, for a clean edge
SHADOW_BLUR = 14
SHADOW_DROP = 10
SHADOW_ALPHA = 0.30
GLOSS_ALPHA = 0.10
EDGE_ALPHA = 0.12
EDGE_WIDTH = 3


def squircle(size):
    """The body's mask: |x|^n + |y|^n = 1, drawn large and reduced."""
    big = size * SUPER
    half = big / 2
    points = []
    steps = 720
    import math
    for i in range(steps):
        t = 2 * math.pi * i / steps
        c, s = math.cos(t), math.sin(t)
        x = half + half * math.copysign(abs(c) ** (2 / EXPONENT), c)
        y = half + half * math.copysign(abs(s) ** (2 / EXPONENT), s)
        points.append((x, y))
    mask = Image.new("L", (big, big), 0)
    ImageDraw.Draw(mask).polygon(points, fill=255)
    return mask.resize((size, size), Image.LANCZOS)


def master(appearance):
    art = Image.open(ROOT / f"crates/chilpa-qt-kit/assets/app-icon-{appearance}.png").convert("RGBA")
    # The art's own rounded corners are transparent; the field under it is its edge color.
    field = Image.new("RGBA", art.size, art.getpixel((art.width // 2, 6))[:3] + (255,))
    field.alpha_composite(art)
    # The dark art draws its own keyline along its own corners; the body's edge is drawn here.
    field = field.crop((TRIM, TRIM, field.width - TRIM, field.height - TRIM))
    body = field.resize((BODY, BODY), Image.LANCZOS)
    mask = squircle(BODY)

    # A faint light from above and a hairline edge, as a raised plate has.
    gloss = Image.new("L", (BODY, BODY), 0)
    top = int(BODY * 0.45)
    for y in range(top):
        gloss.paste(int(255 * GLOSS_ALPHA * (1 - y / top) ** 2), (0, y, BODY, y + 1))
    body.alpha_composite(Image.merge("RGBA", (Image.new("L", (BODY, BODY), 255),) * 3 + (ImageChops.multiply(gloss, mask),)))
    inner = mask.filter(ImageFilter.MinFilter(EDGE_WIDTH * 2 + 1))
    edge = ImageChops.subtract(mask, inner).point(lambda v: int(v * EDGE_ALPHA))
    body.alpha_composite(Image.merge("RGBA", (Image.new("L", (BODY, BODY), 255),) * 3 + (edge,)))
    body.putalpha(mask)

    canvas = Image.new("RGBA", (CANVAS, CANVAS), (0, 0, 0, 0))
    offset = (CANVAS - BODY) // 2
    shadow = Image.new("L", (CANVAS, CANVAS), 0)
    shadow.paste(mask, (offset, offset + SHADOW_DROP))
    shadow = shadow.filter(ImageFilter.GaussianBlur(SHADOW_BLUR)).point(lambda v: int(v * SHADOW_ALPHA))
    canvas.alpha_composite(Image.merge("RGBA", (Image.new("L", (CANVAS, CANVAS), 0),) * 3 + (shadow,)))
    canvas.alpha_composite(body, (offset, offset))
    return canvas


for appearance in ("light", "dark"):
    out = ROOT / f"crates/chilpa-qt-kit/assets/app-icon-macos-{appearance}.png"
    master(appearance).save(out, optimize=True)
    print(f"macos-icon: {out.relative_to(ROOT)}")
