(version 1)
(deny default)
(allow sysctl-read)
(allow process-info* (target self))
(allow signal (target self))
(allow process-exec (literal (param "PROGRAM")))
(allow file-read-metadata)
(allow file-read*
    (literal "/")
    (subpath (param "PLUGIN"))
    (subpath "/System/Library")
    (subpath "/usr/lib")
    (subpath "/usr/share/zoneinfo")
    (subpath "/private/var/db/dyld")
    (subpath "/Library/Apple/System/Library")
    (subpath "/private/etc/ssl")
    (literal "/private/etc/hosts" "/private/etc/resolv.conf" "/private/etc/localtime")
    (literal "/dev/null" "/dev/random" "/dev/urandom"))
(allow file-map-executable
    (subpath (param "PLUGIN"))
    (subpath "/System/Library")
    (subpath "/usr/lib")
    (subpath "/Library/Apple/System/Library"))
(allow file-read* file-write*
    (subpath (param "DATA"))
    (subpath (param "CACHE")))
(allow file-write* (literal "/dev/null"))
(allow mach-lookup
    (global-name "com.apple.system.logger")
    (global-name "com.apple.system.notification_center")
    (global-name "com.apple.logd")
    (global-name "com.apple.bsd.dirhelper"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
