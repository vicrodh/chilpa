msgid "The renderer description could not be read."
msgstr "Не удалось прочитать описание рендерера."

msgid "The renderer did not answer. Check its connection."
msgstr "Рендерер не ответил. Проверьте подключение."

msgid "The renderer does not support this format or control. Chilpa does not transcode."
msgstr "Рендерер не поддерживает этот формат или команду. Chilpa не перекодирует."

msgid "The renderer refused the command."
